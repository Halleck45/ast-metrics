# Distribution image: fetches the precompiled binary from the GitHub release.
# Built as a multi-arch image by .github/workflows/distribute.yml:
#   docker buildx build --platform linux/amd64,linux/arm64 --build-arg VERSION=v0.39.0 -f Dockerfile.release .
# A glibc base is required: release binaries are compiled with CGO on Ubuntu.
FROM debian:stable-slim

ARG TARGETARCH
ARG VERSION

LABEL org.opencontainers.image.source="https://github.com/ast-metrics/ast-metrics" \
      org.opencontainers.image.description="Multi-language static code analyzer: complexity, coupling and maintainability metrics" \
      org.opencontainers.image.licenses="MIT"

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git \
    && rm -rf /var/lib/apt/lists/*

RUN case "${TARGETARCH}" in \
        amd64) ASSET_ARCH="x86_64" ;; \
        arm64) ASSET_ARCH="arm64" ;; \
        *) echo "unsupported arch: ${TARGETARCH}" && exit 1 ;; \
    esac \
    && curl -fsSL -o /usr/local/bin/ast-metrics \
        "https://github.com/ast-metrics/ast-metrics/releases/download/${VERSION}/ast-metrics_Linux_${ASSET_ARCH}" \
    && chmod +x /usr/local/bin/ast-metrics

WORKDIR /src

ENTRYPOINT ["ast-metrics"]
CMD ["--help"]
